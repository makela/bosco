#!/usr/bin/env bash
# Runs `make check` (nix flake check: builds plus unit and integration tests)
# before every push. Skip it once with `git push --no-verify`.
#
# Enable in a fresh clone with: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# The flake checks the working tree, not the commits being pushed
if ! git diff --quiet HEAD; then
    echo "pre-push: warning: uncommitted changes are included in the check" >&2
fi

echo "pre-push: running make check" >&2
if [ -n "${IHP:-}" ]; then
    make check
else
    # Not inside the dev shell, where ${IHP}/Makefile.dist is available
    direnv exec . make check
fi
