#!/usr/bin/env bash
# Runs `just check-all` (nix flake check: every build, the release one too,
# and all the tests) before every push. Skip it once with `git push --no-verify`.
#
# Enabled by the dev shell (core.hooksPath = .githooks).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# The flake checks the working tree, not the commits being pushed
if ! git diff --quiet HEAD; then
    echo "pre-push: warning: uncommitted changes are included in the check" >&2
fi

echo "pre-push: running just check-all" >&2
if command -v just >/dev/null && command -v cargo >/dev/null; then
    just check-all
else
    # Outside the dev shell, e.g. from a GUI git client
    nix develop --command just check-all
fi
